{
  "name": "streamdeck-aopi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run typecheck && node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --test tests/*.test.ts",
    "validate": "streamdeck validate com.aetherone.streamdeck.sdPlugin",
    "pack": "streamdeck pack com.aetherone.streamdeck.sdPlugin --output dist"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.4"
  },
  "devDependencies": {
    "@elgato/cli": "^1.7.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.27.0",
    "typescript": "^5.9.3"
  }
}
