{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "AetherOnePi",
  "Category": "AetherOnePi",
  "CategoryIcon": "imgs/category",
  "UUID": "com.aetherone.streamdeck",
  "Author": "AetherOnePi",
  "Description": "Use server-defined AetherOnePi menus on Stream Deck.",
  "Icon": "imgs/plugin",
  "Version": "1.0.0.0",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "Nodejs": {
    "Version": "24"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    },
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    }
  ],
  "CodePath": "bin/plugin.mjs",
  "PropertyInspectorPath": "ui/settings.html",
  "Profiles": [
    {
      "Name": "profiles/aopi-plus-xl",
      "DeviceType": 13,
      "AutoInstall": true
    }
  ],
  "Actions": [
    {
      "UUID": "com.aetherone.streamdeck.key",
      "Name": "AOPi Key Slot",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/blank",
          "TitleAlignment": "bottom"
        }
      ],
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false
    },
    {
      "UUID": "com.aetherone.streamdeck.encoder",
      "Name": "AOPi Encoder Slot",
      "Icon": "imgs/action",
      "Controllers": [
        "Encoder"
      ],
      "States": [
        {
          "Image": "imgs/blank",
          "TitleAlignment": "bottom"
        }
      ],
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "Encoder": {
        "layout": "layouts/status-dial.json"
      }
    }
  ]
}